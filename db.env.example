# ==============================================================================
# Lares Telemetry / LabSCADA Database Configuration
# ==============================================================================
# Copy this file to /etc/labscada/db.env (or .env in this directory)
# to override the default local database connection.
#
# By default (when db.env is not present), the system connects to the local
# edge PostgreSQL database at 127.0.0.1:5432 for maximum offline resilience.

# Hostname or IP address (e.g. 127.0.0.1 or Google Cloud SQL Public/Private IP)
SCADA_PG_HOST=127.0.0.1

# Port (default PostgreSQL port is 5432)
SCADA_PG_PORT=5432

# Database Name
SCADA_PG_DB=rapid_scada

# Database User
SCADA_PG_USER=postgres

# Database Password
SCADA_PG_PASS=postgres

# SSL Mode: disable, allow, prefer, require, verify-ca, verify-full
# For Google Cloud SQL or external connections, use "require"
SCADA_PG_SSLMODE=prefer
