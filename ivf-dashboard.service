[Unit]
Description=IVF Lab Clinical Web Dashboard & Controller
After=network.target scadacomm6.service

[Service]
Type=simple
User=bobostrom
WorkingDirectory=/home/bobostrom/Projects/scada
ExecStart=/usr/bin/python3 /home/bobostrom/Projects/scada/ivf_dashboard_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
