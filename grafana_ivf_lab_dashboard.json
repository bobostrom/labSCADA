      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  triggered_at AS \"Time\",\n  equipment_name AS \"Equipment\",\n  alarm_type AS \"Alarm Condition\",\n  CASE \n    WHEN excursion_val IS NOT NULL THEN ROUND(excursion_val::numeric, 1)::text || ' °C'\n    ELSE 'TRIPPED'\n  END AS \"Reading\",\n  CASE \n    WHEN NOT is_acknowledged AND NOT is_resolved THEN '🔴 ACTIVE (SIREN)'\n    WHEN is_acknowledged AND NOT is_resolved THEN '🟡 Attending (' || COALESCE(acknowledged_by, 'Staff') || ')'\n    ELSE '🟢 Resolved (' || COALESCE(ROUND(duration_seconds / 60.0, 1)::text || 'm', 'OK') || ')'\n  END AS \"Status\",\n  id AS \"Action\"\nFROM mod_arc_postgre_sql.alarm_events\nORDER BY triggered_at DESC\nLIMIT 15;",
          "refId": "A"
        }
      ],
      "title": "Active Alarms & Regulatory Excursion History (Reverse Chronological)",
      "type": "table"
