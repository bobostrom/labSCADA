# ==============================================================================
# Lares Telemetry: Site Configuration Template
# ==============================================================================
# Copy this file to /etc/labscada/site.env on the target SCADA host.
# Systemd (ivf-alert-engine.service) and the Python engine load these variables on boot.
# ==============================================================================

# 1. Clinical Facility Identity & White-Label Branding
CLINIC_NAME="Advanced Fertility of Alaska"
CLINIC_SLUG="komdivflab"
CLINIC_DOMAIN="komdivflab.larestelemetry.com"
CLINIC_LOGO="/assets/KOMDlogo.png"

# 2. Pushover Emergency Notification Gateway
# Under your master Pushover account, create a dedicated Application and Delivery Group for each site:
PUSHOVER_TOKEN="your_pushover_app_token_here"
PUSHOVER_GROUP="your_pushover_group_key_here"
PUSHOVER_PING_URL="https://api.pushover.net/1/monitors/your_ping_token/ping.json"

# 3. Target PLC & OPC UA Connection
PLC_HOST="afoa-plc"
PLC_OPC_URL="opc.tcp://afoa-plc:4840"

# 4. Simulation Mode Override
# Set to 'true' to simulate readings in the engine if PLC is offline
SIMULATION_MODE=false
