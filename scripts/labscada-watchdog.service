[Unit]
Description=LabSCADA Pushover Health Watchdog
After=network-online.target scadaserver6.service scadacomm6.service ivf-alert-engine.service
Wants=network-online.target

[Service]
Type=simple
User=bobostrom
WorkingDirectory=/home/bobostrom/Projects/labSCADA
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/labscada/site.env
ExecStart=/usr/bin/python3 /home/bobostrom/Projects/labSCADA/scripts/pushover_watchdog.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

